# Copy to .env. .env is gitignored.

# Remote Chrome with CDP. Point at any Chrome started with
# --remote-debugging-port and the right --user-data-dir.
CDP_URL=http://chrome-host:9222

# Twitter / X login (optional — only if you want to script the login; otherwise
# log in interactively the first time and we capture cookies)
TWITTER_USERNAME=
TWITTER_PASSWORD=
